      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B2_di" bpmnElement="B2" bioc:fill="#edf4fd" bioc:stroke="#315f8a">
        <dc:Bounds x="374" y="280" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B3_di" bpmnElement="B3" bioc:fill="#e1ecfa" bioc:stroke="#17568c">
