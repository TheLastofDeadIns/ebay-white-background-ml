      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B4_di" bpmnElement="B4" bioc:fill="#edf4fd" bioc:stroke="#315f8a">
        <dc:Bounds x="897" y="280" width="169" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B5_di" bpmnElement="B5" bioc:fill="#fff2dc" bioc:stroke="#925820">
        <dc:Bounds x="897" y="406" width="169" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge" bioc:fill="#edf4fd" bioc:stroke="#315f8a" isMarkerVisible="true">
        <dc:Bounds x="1125" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B6_di" bpmnElement="B6" bioc:fill="#e6f7ef" bioc:stroke="#22715c">
        <dc:Bounds x="1194" y="103" width="175" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B7_di" bpmnElement="B7" bioc:fill="#edf4fd" bioc:stroke="#315f8a">
        <dc:Bounds x="1265" y="280" width="169" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B8_di" bpmnElement="B8" bioc:fill="#f0ebfa" bioc:stroke="#6a5197">
        <dc:Bounds x="1480" y="280" width="173" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End" bioc:fill="#e6f7ef" bioc:stroke="#22715c">
        <dc:Bounds x="1694" y="125" width="36" height="36" />
