<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Photo" targetNamespace="urn:ebay-photo:educational-reconstruction">
  <bpmn:collaboration id="Collaboration_Photo">
    <bpmn:participant id="Pool" name="eBay · Белый фон для одного фото" processRef="Photo" />
  </bpmn:collaboration>
  <bpmn:process id="Photo" name="eBay · Замена фона одного фото на белый" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Seller" name="Продавец eBay">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Editor" name="Веб-редактор фото">
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Worker" name="ML-воркер">
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimeLimit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Фото открыто">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="B1" name="B1 · Выбрать белый фон">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B2" name="B2 · Запросить маску товара">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B3" name="B3 · Вычислить маску товара">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="TimeLimit" name="1,5 с" attachedToRef="B3" cancelActivity="true">
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition">
        <bpmn:timeDuration>PT1.5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Quality" name="Маска пригодна?" default="Flow_6">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B4" name="B4 · Собрать предпросмотр">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B5" name="B5 · Предложить исходное фото">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B6" name="B6 · Выбрать и подтвердить фото">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="B7" name="B7 · Сохранить фото в черновик">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B8" name="B8 · Зарегистрировать исход попытки">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="Output_Signal" name="Событие об исходе" />
        <bpmn:inputSet id="Inputs_B8" />
        <bpmn:outputSet id="Outputs_B8">
          <bpmn:dataOutputRefs>Output_Signal</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="Signal_edge">
        <bpmn:sourceRef>Output_Signal</bpmn:sourceRef>
        <bpmn:targetRef>Signal</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Фото сохранено">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="B1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="B1" targetRef="B2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="B2" targetRef="B3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="B3" targetRef="Quality" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Quality" targetRef="B4" name="Да · q ≥ 0,85">
      <bpmn:conditionExpression>Ответ успешен и q &gt;= 0.85</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Quality" targetRef="B5" name="Нет · q &lt; 0,85 или сбой" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="B4" targetRef="Merge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="B5" targetRef="Merge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Merge" targetRef="B6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="B6" targetRef="B7" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="B7" targetRef="B8" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="B8" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="TimeLimit" targetRef="B5" name="Тайм-аут" />
    <bpmn:dataObject id="Data_Signal" />
    <bpmn:dataObjectReference id="Signal" name="Сигнал для обучения и оценки" dataObjectRef="Data_Signal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram" name="eBay · Замена фона одного фото на белый">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration_Photo">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" bioc:fill="#ffffff" bioc:stroke="#61768a" isHorizontal="true">
        <dc:Bounds x="36" y="72" width="1725" height="590" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Seller_di" bpmnElement="Seller" bioc:fill="#ffffff" bioc:stroke="#61768a" isHorizontal="true">
        <dc:Bounds x="66" y="72" width="1695" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Editor_di" bpmnElement="Editor" bioc:fill="#ffffff" bioc:stroke="#61768a" isHorizontal="true">
        <dc:Bounds x="66" y="224" width="1695" height="286" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Worker_di" bpmnElement="Worker" bioc:fill="#ffffff" bioc:stroke="#61768a" isHorizontal="true">
        <dc:Bounds x="66" y="510" width="1695" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start" bioc:fill="#e6f7ef" bioc:stroke="#22715c">
